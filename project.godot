; Projet Godot du jeu « Les Damnés des Sept Mers ».
; Godot 4.7.2, rendu Mobile, format paysage.

config_version=5

[application]

config/name="Les Damnés des Sept Mers"
config/version="0.4.0"
run/main_scene="res://ui/screens/demarrage.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Partie="*res://autoload/partie.gd"
Reseau="*res://autoload/reseau.gd"
Sauvegarde="*res://autoload/sauvegarde.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
